# The lab's fixed facts. Sourced by every script; override with env vars.

# --- host side: the Proxmox VM under libvirt ---------------------------------
PVE_VM=${PVE_VM:-homedash-pve}
PVE_NET=${PVE_NET:-homedash-pve}            # libvirt NAT network, 10.20.30.0/24
PVE_DIR=${PVE_DIR:-$HOME/.homedash}          # qcow2, ISO, answer.toml, ssh key
PVE_VCPUS=${PVE_VCPUS:-14}
PVE_MEM=${PVE_MEM:-28G}
PVE_DISK=${PVE_DISK:-64G}
LAB_KEY=${LAB_KEY:-$PVE_DIR/ssh/id_ed25519}
PVE_ISO=${PVE_ISO:-$PVE_DIR/proxmox-ve_9.2-1.iso}

# --- inside Proxmox: two houses, each NATed behind vmbr0 ---------------------
HOUSE_A_BR=vmbr1; HOUSE_A_NET=10.1.0.0/24; HOUSE_A_GW=10.1.0.1
HOUSE_B_BR=vmbr2; HOUSE_B_NET=10.2.0.0/24; HOUSE_B_GW=10.2.0.1

DEBIAN_IMG_URL=${DEBIAN_IMG_URL:-https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2}
TEMPLATE_ID=9100
PVE_STORAGE=${PVE_STORAGE:-local-lvm}

# id  name          bridge  ip          cores  mem(MB)  extra disks (GB, space separated)
VMS='
101 hub-a         vmbr1 10.1.0.10 2 2048 -
102 remote-small  vmbr1 10.1.0.11 1 1024 4
103 remote-mid    vmbr1 10.1.0.12 2 3072 8
104 remote-big    vmbr1 10.1.0.13 4 6144 8,8
201 hub-b         vmbr2 10.2.0.10 2 2048 -
202 remote-b      vmbr2 10.2.0.11 2 3072 8
'

# Each house has its own NAT router, a network namespace on Proxmox with a
# LAN leg on the house bridge (the guests' gateway) and a WAN leg on vmbr0
# with its own public address. Proxmox keeps a management address on each
# bridge and routes nothing.
HOUSE_A_PUBLIC=${HOUSE_A_PUBLIC:-10.20.30.201}
HOUSE_B_PUBLIC=${HOUSE_B_PUBLIC:-10.20.30.202}
HOUSE_A_MGMT=10.1.0.2
HOUSE_B_MGMT=10.2.0.2
UPSTREAM_GW=10.20.30.1                        # libvirt's NAT, the way to the internet
